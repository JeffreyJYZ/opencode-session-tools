{
  "name": "@jeffreyjyz/opencode-session-tools",
  "version": "0.1.2",
  "description": "Cross-session tools for opencode: list sessions, ask another session a question and get its answer, rename, move, and interrupt (which also stops its subagents and shells).",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "SKILL.md",
    "README.md",
    "install.sh"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "sync": "cp src/index.ts ~/.config/opencode/plugin/session-tools.ts && echo 'synced; opencode reloads it on save or the next config touch'"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "session",
    "subagent",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyJYZ/opencode-session-tools.git"
  },
  "homepage": "https://github.com/JeffreyJYZ/opencode-session-tools#readme",
  "bugs": "https://github.com/JeffreyJYZ/opencode-session-tools/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.3",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
